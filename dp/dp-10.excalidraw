    {
      "id": "OQAnghJYZU12YO5jyrP8I",
      "type": "text",
      "x": -347.5273378582219,
      "y": 540547.0833333333,
      "width": 1814.998291015625,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0X",
      "roundness": null,
      "seed": 269148224,
      "version": 427,
      "versionNonce": 1880358038,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786315084060,
      "link": null,
      "locked": false,
      "text": "if a problem can be solved by Greedy approach; it means that it \nis guranteed; that at each step ; you make a choice and that\nchoice is the best possible for now as well as future. Then you\ncan solve the problem using Greed method\n_> if there are multiple choices at each step and it is not clear \nwhich choice can given you the best answer long term => use DP",
      "fontSize": 50,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if a problem can be solved by Greedy approach; it means that it \nis guranteed; that at each step ; you make a choice and that\nchoice is the best possible for now as well as future. Then you\ncan solve the problem using Greed method\n_> if there are multiple choices at each step and it is not clear \nwhich choice can given you the best answer long term => use DP",
      "autoResize": true,
      "lineHeight": 1.25
    },
