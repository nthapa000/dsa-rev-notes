      "groupIds": [],
      "frameId": null,
      "index": "bQS",
      "roundness": null,
      "seed": 81744790,
      "version": 1007,
      "versionNonce": 1190707670,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786341012635,
      "link": null,
      "locked": false,
      "text": "class Solution:\n    def countJourneys(self, N: int, A: List[int]) -> Tuple[int, int]:\n        dp = [[0] * 2 for _ in range(N+1)]\n        # dp[i][0] : means that no. of journey from start = 1 (first no.) to end to ith number and the sum\n        is Even\n        # dp[i][1] : means the no. of journey from start = 1(first no.) to the the ith number and the sum is odd\n        if A[0]%2==0:\n            dp[1][0] = 1\n            dp[1][1] = 0\n        else:\n            dp[1][0] = 0\n            dp[1][1] = 1\n        \n        # now calculate dp[2][0] and dp[2][1]\n        if A[1] % 2 == 0:\n            # second no. is even\n            dp[2][0] = dp[1][0]\n            dp[2][1] = dp[1][1]\n        else:\n            dp[2][0] = dp[1][1]\n            dp[2][1] = dp[1][0]\n        \n        for i in range(3, N+1):\n            if A[i]%2==0:\n                # Even no.\n                # no. of joureny sum is even\n                dp[i][0] = dp[i-1][0] + dp[i-2][0]\n                # no. of journey sum is odd\n                dp[i][1] = dp[i-1][1] + dp[i-2][1]\n            else:\n                dp[i][0] = dp[i-1][1] + dp[i-2][1]\n                dp[i][1] = dp[i-1][0] + dp[i-2][0]\n\n       return (dp[N][0],dp[N][1])\n         \n            ",
      "fontSize": 55,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution:\n    def countJourneys(self, N: int, A: List[int]) -> Tuple[int, int]:\n        dp = [[0] * 2 for _ in range(N+1)]\n        # dp[i][0] : means that no. of journey from start = 1 (first no.) to end to ith number and the sum\n        is Even\n        # dp[i][1] : means the no. of journey from start = 1(first no.) to the the ith number and the sum is odd\n        if A[0]%2==0:\n            dp[1][0] = 1\n            dp[1][1] = 0\n        else:\n            dp[1][0] = 0\n            dp[1][1] = 1\n        \n        # now calculate dp[2][0] and dp[2][1]\n        if A[1] % 2 == 0:\n            # second no. is even\n            dp[2][0] = dp[1][0]\n            dp[2][1] = dp[1][1]\n        else:\n            dp[2][0] = dp[1][1]\n            dp[2][1] = dp[1][0]\n        \n        for i in range(3, N+1):\n            if A[i]%2==0:\n                # Even no.\n                # no. of joureny sum is even\n                dp[i][0] = dp[i-1][0] + dp[i-2][0]\n                # no. of journey sum is odd\n                dp[i][1] = dp[i-1][1] + dp[i-2][1]\n            else:\n                dp[i][0] = dp[i-1][1] + dp[i-2][1]\n                dp[i][1] = dp[i-1][0] + dp[i-2][0]\n\n       return (dp[N][0],dp[N][1])\n         \n            ",
      "autoResize": true,
      "lineHeight": 1.25
    }
