      "isDeleted": true,
      "boundElements": null,
      "updated": 1786315084060,
      "link": null,
      "locked": false,
      "text": "Code:\nfrom typing import List\n\nclass Solution:\n    def maximumSum(self, A: List[int], B: List[int], C: List[int]) -> int:\n        size = len(A)\n\n        sum = 0\n        for i in range(size):\n            sum += max(A[i],B[i],C[i])\n        \n        return sum\n",
      "fontSize": 50,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Code:\nfrom typing import List\n\nclass Solution:\n    def maximumSum(self, A: List[int], B: List[int], C: List[int]) -> int:\n        size = len(A)\n\n        sum = 0\n        for i in range(size):\n            sum += max(A[i],B[i],C[i])\n        \n        return sum\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
