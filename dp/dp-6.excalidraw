    {
      "id": "9aWGRVWUn8otPhmTjPpGA",
      "type": "text",
      "x": -1003.3333333333344,
      "y": 528381.4583333333,
      "width": 1576.852783203125,
      "height": 2440,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bO6",
      "roundness": null,
      "seed": 1082505294,
      "version": 5,
      "versionNonce": 1043204686,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785790159595,
      "link": null,
      "locked": false,
      "text": "def solve(n: int, k: int, h: list[int]) -> int:\n    # Write your core logic here\n    dp = [-1]*(n+1)\n    dp[1] = 0\n    dp[2] = abs(h[1]-h[0])\n    # constraint is N is greater than 2\n    \n    i = 3\n    while i<=n:\n      # we can jump from \n      ans = 10**18+1\n      j=1\n      while j<=k and i-j-1>=0:\n        option = abs(h[i-1]-h[i-j-1])+dp[i-j]\n        ans = min(ans,option)\n        j+=1\n      dp[i]=ans\n      i += 1\n    return dp[n]\n        \n      \n\n\ndef main():\n    n, k = map(int, input().split())\n    h = list(map(int, input().split()))\n\n    print(solve(n, k, h))\n\n\nif __name__ == \"__main__\":\n    main()",
      "fontSize": 61,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def solve(n: int, k: int, h: list[int]) -> int:\n    # Write your core logic here\n    dp = [-1]*(n+1)\n    dp[1] = 0\n    dp[2] = abs(h[1]-h[0])\n    # constraint is N is greater than 2\n    \n    i = 3\n    while i<=n:\n      # we can jump from \n      ans = 10**18+1\n      j=1\n      while j<=k and i-j-1>=0:\n        option = abs(h[i-1]-h[i-j-1])+dp[i-j]\n        ans = min(ans,option)\n        j+=1\n      dp[i]=ans\n      i += 1\n    return dp[n]\n        \n      \n\n\ndef main():\n    n, k = map(int, input().split())\n    h = list(map(int, input().split()))\n\n    print(solve(n, k, h))\n\n\nif __name__ == \"__main__\":\n    main()",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
