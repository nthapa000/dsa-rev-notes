    {
      "id": "fsyLY-dE3m25UX9jlXsQt",
      "type": "text",
      "x": -1090.8333333333344,
      "y": 518428.95833333326,
      "width": 3187.25537109375,
      "height": 1906.25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bIw",
      "roundness": null,
      "seed": 1804490510,
      "version": 9,
      "versionNonce": 1396537042,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785787665333,
      "link": null,
      "locked": false,
      "text": "def solve(n: int, h: list[int]) -> int:\n    # Write your core logic here\n    dp = [-1]*(len(h)+1)\n    # dp[1] means when the size of array is 1 what will be the min cost to reach first element,\n    # its zero since we are already in the 0th index \n    dp[1] = 0\n    dp[2] = abs(h[1]-h[0])\n    if len(h)==2:\n      return dp[2]\n    dp[3] = min((abs(h[2]-h[1])+dp[2]), abs(h[2]-h[0]))\n    \n    for i in range(4,(len(h)+1)):\n      dp[i] = min((abs(h[i-1] - h[i-2])+dp[i-1]), (abs(h[i-1] - h[i-3])+dp[i-2]))\n\n    return dp[len(h)]\n\ndef main():\n    n = int(input())\n    h = list(map(int, input().split()))\n\n    print(solve(n, h))\n\n\nif __name__ == \"__main__\":\n    main()",
      "fontSize": 61,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def solve(n: int, h: list[int]) -> int:\n    # Write your core logic here\n    dp = [-1]*(len(h)+1)\n    # dp[1] means when the size of array is 1 what will be the min cost to reach first element,\n    # its zero since we are already in the 0th index \n    dp[1] = 0\n    dp[2] = abs(h[1]-h[0])\n    if len(h)==2:\n      return dp[2]\n    dp[3] = min((abs(h[2]-h[1])+dp[2]), abs(h[2]-h[0]))\n    \n    for i in range(4,(len(h)+1)):\n      dp[i] = min((abs(h[i-1] - h[i-2])+dp[i-1]), (abs(h[i-1] - h[i-3])+dp[i-2]))\n\n    return dp[len(h)]\n\ndef main():\n    n = int(input())\n    h = list(map(int, input().split()))\n\n    print(solve(n, h))\n\n\nif __name__ == \"__main__\":\n    main()",
      "autoResize": true,
      "lineHeight": 1.25
    },
