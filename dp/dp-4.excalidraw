      "groupIds": [],
      "frameId": null,
      "index": "b5g",
      "roundness": null,
      "seed": 1521716514,
      "version": 537,
      "versionNonce": 253390526,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785531232171,
      "link": null,
      "locked": false,
      "text": "from typing import List\n\nclass Solution:\n    def minimumCost(self, N: int, A: List[int]) -> int:\n       # N: size of the List\n        dp[1] = 0\n        if N==1:\n            return dp[1]\n        dp[2] = abs(A[1]-A[0])\n        if N==2:\n            return dp[2]\n        dp[3] = abs(A[2] - A[1]) + abs(A[1] - A[0])\n        # dp[4] we have two option \n        # jump from 1->4 and add cost to reach 1 or\n        # jump from 3->4 and add cost to reach 3\n        # which ever is minimum of both is our answer\n        \n        for i in range(4, N+1):\n            dp[i] = min((abs(A[i-1] - A[i-4]) + dp[i-3]),(abs(A[i-1]-A[i-2]) + dp[i-1]))\n        return dp[N]",
      "fontSize": 61,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from typing import List\n\nclass Solution:\n    def minimumCost(self, N: int, A: List[int]) -> int:\n       # N: size of the List\n        dp[1] = 0\n        if N==1:\n            return dp[1]\n        dp[2] = abs(A[1]-A[0])\n        if N==2:\n            return dp[2]\n        dp[3] = abs(A[2] - A[1]) + abs(A[1] - A[0])\n        # dp[4] we have two option \n        # jump from 1->4 and add cost to reach 1 or\n        # jump from 3->4 and add cost to reach 3\n        # which ever is minimum of both is our answer\n        \n        for i in range(4, N+1):\n            dp[i] = min((abs(A[i-1] - A[i-4]) + dp[i-3]),(abs(A[i-1]-A[i-2]) + dp[i-1]))\n        return dp[N]",
      "autoResize": true,
      "lineHeight": 1.25
    }
