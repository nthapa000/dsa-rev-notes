    {
      "id": "-RCTZekN5vHhQaKEC8Np3",
      "type": "text",
      "x": -843.3333333333344,
      "y": 484639.58333333326,
      "width": 2952.4052734375,
      "height": 1525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
