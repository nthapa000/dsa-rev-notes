      "seed": 258207647,
      "version": 629,
      "versionNonce": 445607057,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786706123020,
      "link": null,
      "locked": false,
      "text": "def main():\n    # input the array size and its element\n    n = int(input(\"Enter the size of the array\"))\n    list = []\n    for i in range(n):\n        list.append(int(input()))\n    \n    q_n = int(input(\"Enter the queries size\"))\n    queries = []\n    for i in range(q_n):\n        queries.append(int(input()))\n    \n    occ_arr = []\n    for i in range(q_n):\n        occ = 0\n        curr_ele = queries[i] \n        for j in range(n):\n            if list[j] == curr_ele:\n                occ += 1\n        occ_arr.append(occ)\n    \n    return occ_arr\n    \n\nif __name__ == \"__main__\":\n    result = main()\n    print(result)",
      "fontSize": 39,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def main():\n    # input the array size and its element\n    n = int(input(\"Enter the size of the array\"))\n    list = []\n    for i in range(n):\n        list.append(int(input()))\n    \n    q_n = int(input(\"Enter the queries size\"))\n    queries = []\n    for i in range(q_n):\n        queries.append(int(input()))\n    \n    occ_arr = []\n    for i in range(q_n):\n        occ = 0\n        curr_ele = queries[i] \n        for j in range(n):\n            if list[j] == curr_ele:\n                occ += 1\n        occ_arr.append(occ)\n    \n    return occ_arr\n    \n\nif __name__ == \"__main__\":\n    result = main()\n    print(result)",
      "autoResize": true,
      "lineHeight": 1.25
    },
