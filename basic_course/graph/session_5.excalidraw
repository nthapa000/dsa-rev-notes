      "isDeleted": false,
      "boundElements": null,
      "updated": 1788178383555,
      "link": null,
      "locked": false,
      "text": "n = int(input())\nm = int(input())\n\nadj_list = [ [] for _ in range(n+1))\n\ni = 1\nwhile i<=m:\n    x , y = map (int,input().split())\n    adj_list[x].append(y)\n    adj_list[y].append(x)\n    i++\n    \n\nvisited = [0]*(n+1)\nparent = [0]*(n+1)\n\ndef dfs(node, adj_list, visited, parent):\n    print(node)\n    visited[node] = 1\n    \n    for neigh in adj_list[node]:\n        if visited[neigh] == 0:\n            parent[neigh] = node\n            dfs(neigh, adj_list, visited, parent)\n    \n\ndfs(1,adj_list,visited,parent)",
      "fontSize": 81,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "n = int(input())\nm = int(input())\n\nadj_list = [ [] for _ in range(n+1))\n\ni = 1\nwhile i<=m:\n    x , y = map (int,input().split())\n    adj_list[x].append(y)\n    adj_list[y].append(x)\n    i++\n    \n\nvisited = [0]*(n+1)\nparent = [0]*(n+1)\n\ndef dfs(node, adj_list, visited, parent):\n    print(node)\n    visited[node] = 1\n    \n    for neigh in adj_list[node]:\n        if visited[neigh] == 0:\n            parent[neigh] = node\n            dfs(neigh, adj_list, visited, parent)\n    \n\ndfs(1,adj_list,visited,parent)",
      "autoResize": true,
      "lineHeight": 1.25
    },
