    },
    {
      "id": "Pwo7BYyv8Ooukc9HhODKI",
      "type": "text",
      "x": -782.9904758529843,
      "y": 388463.16671666654,
      "width": 485.1002197265625,
      "height": 367.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
