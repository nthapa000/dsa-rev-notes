    {
      "id": "nRQbj_m2h6iGqsGdnf0LP",
      "type": "text",
      "x": 2137.9604697348964,
      "y": 363673.1667166665,
      "width": 2143.106201171875,
      "height": 1119.1666666668316,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5m",
      "roundness": null,
      "seed": 51252355,
      "version": 473,
      "versionNonce": 658143651,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788173085019,
      "link": null,
      "locked": false,
      "text": "def shortest_distance(adjList: list[list[int]], source: int) -> list[int]:\n    distance = [0] * (n+1)\n    # 1 based numbering notation\n    visited  = [False] * (n+1)\n    q = deque()\n    q.append(source)\n    distance[source] = 0\n    visited[source] = True\n    while q:\n        removed_node = q.popleft()\n        for neighbor in adj[removed_node]:\n            if visited[neighbor] == False:\n                q.append(neighbor)\n                distance[neighbor] = distance[removed_node] + 1\n                visited[neighbor] = False\n\n    return distance",
      "fontSize": 52.66666666667442,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def shortest_distance(adjList: list[list[int]], source: int) -> list[int]:\n    distance = [0] * (n+1)\n    # 1 based numbering notation\n    visited  = [False] * (n+1)\n    q = deque()\n    q.append(source)\n    distance[source] = 0\n    visited[source] = True\n    while q:\n        removed_node = q.popleft()\n        for neighbor in adj[removed_node]:\n            if visited[neighbor] == False:\n                q.append(neighbor)\n                distance[neighbor] = distance[removed_node] + 1\n                visited[neighbor] = False\n\n    return distance",
      "autoResize": true,
      "lineHeight": 1.25
    },
