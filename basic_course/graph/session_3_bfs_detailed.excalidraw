    {
      "id": "rEABwxj2H-R-5wMPf3XGE",
      "type": "text",
      "x": 3485.226868677566,
      "y": 377263.16671666654,
      "width": 1316.7003597337716,
      "height": 2185.000000000058,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBF",
      "roundness": null,
      "seed": 1766157613,
      "version": 266,
      "versionNonce": 266611693,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788175651091,
      "link": null,
      "locked": false,
      "text": "from collections import deque\n\nn, m = map(int, input().split())\n\nvalue = list(map(int, input().split()))\n\nadj_list = [[] for _ in range(n + 1)]\n\nfor _ in range(m):\n    x, y = map(int, input().split())\n\n    adj_list[x].append(y)\n    adj_list[y].append(x)\n\nvisited = [False] * (n + 1)\nlevel = [0] * (n + 1)\nfive = [0] * (n + 1)\n\nq = deque()\n\nq.append(1)\nvisited[1] = True\nfive[1] = 1 if value[0] == 5 else 0\n\nwhile q:\n    v = q.popleft()\n\n    for u in adj_list[v]:\n\n        if not visited[u]:\n            visited[u] = True\n            level[u] = level[v] + 1\n            five[u] = five[v] + (1 if value[u - 1] == 5 else 0)\n\n            q.append(u)\n\n        else:\n            # Another shortest path to u\n            if level[v] + 1 == level[u]:\n                five[u] = max(\n                    five[u],\n                    five[v] + (1 if value[u - 1] == 5 else 0)\n                )\n\nfor i in range(1, n + 1):\n    print(i, level[i], five[i])",
      "fontSize": 38.00000000000099,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from collections import deque\n\nn, m = map(int, input().split())\n\nvalue = list(map(int, input().split()))\n\nadj_list = [[] for _ in range(n + 1)]\n\nfor _ in range(m):\n    x, y = map(int, input().split())\n\n    adj_list[x].append(y)\n    adj_list[y].append(x)\n\nvisited = [False] * (n + 1)\nlevel = [0] * (n + 1)\nfive = [0] * (n + 1)\n\nq = deque()\n\nq.append(1)\nvisited[1] = True\nfive[1] = 1 if value[0] == 5 else 0\n\nwhile q:\n    v = q.popleft()\n\n    for u in adj_list[v]:\n\n        if not visited[u]:\n            visited[u] = True\n            level[u] = level[v] + 1\n            five[u] = five[v] + (1 if value[u - 1] == 5 else 0)\n\n            q.append(u)\n\n        else:\n            # Another shortest path to u\n            if level[v] + 1 == level[u]:\n                five[u] = max(\n                    five[u],\n                    five[v] + (1 if value[u - 1] == 5 else 0)\n                )\n\nfor i in range(1, n + 1):\n    print(i, level[i], five[i])",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
