      "text": "def\nshortest_dista\nnce(adjList:\nlist[list[int]\n], source:\nint) ->\nlist[int]:",
      "fontSize": 98,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def shortest_distance(adjList: list[list[int]], source: int) -> list[int]:",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "orxVNj8_IhDZQtAzoaOTS",
      "type": "text",
      "x": 2251.759585182172,
      "y": 364730.66671666654,
      "width": 215.60009765625,
      "height": 122.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
