      "boundElements": null,
      "updated": 1788175278430,
      "link": null,
      "locked": false,
      "text": "while q:\n    v = q.popleft()\n\n    print(v, ways[v])\n    print()\n\n    for u in adj_list[v]:\n\n        if not visited[u]:\n            q.append(u)\n            visited[u] = 1\n            level[u] = level[v] + 1\n            ways[u] = ways[u] + ways[v]\n\n        else:\n            if level[v] + 1 == level[u]:\n                ways[u] = ways[u] + ways[v]",
      "fontSize": 53.764705882352935,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "while q:\n    v = q.popleft()\n\n    print(v, ways[v])\n    print()\n\n    for u in adj_list[v]:\n\n        if not visited[u]:\n            q.append(u)\n            visited[u] = 1\n            level[u] = level[v] + 1\n            ways[u] = ways[u] + ways[v]\n\n        else:\n            if level[v] + 1 == level[u]:\n                ways[u] = ways[u] + ways[v]",
      "autoResize": true,
      "lineHeight": 1.25
