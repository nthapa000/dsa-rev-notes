    {
      "id": "fAF4GME_mzju4vapiY47N",
      "type": "text",
      "x": -480.44036598970297,
      "y": 375796.5000499999,
      "width": 2371.60107421875,
      "height": 2817.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4k",
      "roundness": null,
      "seed": 770125219,
      "version": 4,
      "versionNonce": 1545500835,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1788170817511,
      "link": null,
      "locked": false,
      "text": "class Solution:\n    def bfs(self, adj):\n        # code here\n        # no. of rows\n        n = len(adj)\n        visited = [False] * n\n        result = []\n        \n        q = deque()\n        q.append(0)\n        visited[0] = True\n        while q:\n            node = q.popleft()\n            result.append(node)\n            \n            for neighbor in adj[node]:\n                if not visited[neighbor]:\n                    q.append(neighbor)\n                    visited[neighbor] = True\n        \n        return result\n                \n                ",
      "fontSize": 98,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution:\n    def bfs(self, adj):\n        # code here\n        # no. of rows\n        n = len(adj)\n        visited = [False] * n\n        result = []\n        \n        q = deque()\n        q.append(0)\n        visited[0] = True\n        while q:\n            node = q.popleft()\n            result.append(node)\n            \n            for neighbor in adj[node]:\n                if not visited[neighbor]:\n                    q.append(neighbor)\n                    visited[neighbor] = True\n        \n        return result\n                \n                ",
      "autoResize": true,
      "lineHeight": 1.25
    },
