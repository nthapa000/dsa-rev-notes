      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNM",
      "roundness": null,
      "seed": 1143968976,
      "version": 4,
      "versionNonce": 1212030672,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788167426646,
      "link": null,
      "locked": false,
      "text": "n, m = map(int, input().split())\n\nb = [[0] * 10000 for _ in range(10000)]\n\nfor i in range(1, m + 1):\n    # Taking input for an undirected graph.\n    x, y = map(int, input().split())\n    b[x][y] = 1\n    b[y][x] = 1\n\nfor i in range(n):\n    c = 0\n    for j in range(n):\n        if b[i][j] == 1:\n            c += 1\n    print(f\"{i} {c}\")\n",
      "fontSize": 98,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "n, m = map(int, input().split())\n\nb = [[0] * 10000 for _ in range(10000)]\n\nfor i in range(1, m + 1):\n    # Taking input for an undirected graph.\n    x, y = map(int, input().split())\n    b[x][y] = 1\n    b[y][x] = 1\n\nfor i in range(n):\n    c = 0\n    for j in range(n):\n        if b[i][j] == 1:\n            c += 1\n    print(f\"{i} {c}\")\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
