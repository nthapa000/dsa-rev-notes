      "text": "n,m = input(int,input().split())\ng = [[] for _ in range(n)]\n\nfor i in range (1, m+1):\n    x, y = map(int,input().split())\n    g[x].append(y)\n    g[y].append(x)\n\nfor i in range(n):\n    c = len(g[i])\n    print(f\"{i} {c}\")",
      "fontSize": 98,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "n,m = input(int,input().split())\ng = [[] for _ in range(n)]\n\nfor i in range (1, m+1):\n    x, y = map(int,input().split())\n    g[x].append(y)\n    g[y].append(x)\n\nfor i in range(n):\n    c = len(g[i])\n    print(f\"{i} {c}\")",
