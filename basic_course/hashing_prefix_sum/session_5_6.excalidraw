    {
      "id": "toxumJKc7qmUv0cQ1S4IV",
      "type": "text",
      "x": 1166.357142857143,
      "y": 14486.499999999976,
      "width": 880.0018310546875,
      "height": 560,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bbv",
      "roundness": null,
      "seed": 710419636,
      "version": 343,
      "versionNonce": 1933818676,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786987737787,
      "link": null,
      "locked": false,
      "text": "def main():\n    # taking input\n    # following one based indexing\n\n    prefix_sum = [0] * (n +1)\n    for i in range(1,n+1):\n        prefix_sum[i] = prefix_sum[i-1] + arr[i]\n    \n    for j in range(1, n+1):\n        for i in range(0,j):\n            if prefix_sum[i] == prefix_sum[j] - k:\n                count += 1\n    \n    ",
      "fontSize": 32,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def main():\n    # taking input\n    # following one based indexing\n\n    prefix_sum = [0] * (n +1)\n    for i in range(1,n+1):\n        prefix_sum[i] = prefix_sum[i-1] + arr[i]\n    \n    for j in range(1, n+1):\n        for i in range(0,j):\n            if prefix_sum[i] == prefix_sum[j] - k:\n                count += 1\n    \n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
