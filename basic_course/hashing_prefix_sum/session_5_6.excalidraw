      "isDeleted": false,
      "boundElements": null,
      "updated": 1786991559401,
      "link": null,
      "locked": false,
      "text": "def count_subarrays_optimized(arr, k):\n    from collections import defaultdict\n    \n    prefix_sum_count = defaultdict(int)\n    sum = 0\n    count = 0\n    \n    prefix_sum_count[0] = 1\n    \n    for num in arr:\n        sum += num\n        \n        if (sum - k) in prefix_sum_count:\n            count  += prefix_sum_count[sum - k]\n        \n        prefix_sum_count[sum] += 1\n    \n    # by default , defaultdict has value as zero \n    return count",
      "fontSize": 32,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def count_subarrays_optimized(arr, k):\n    from collections import defaultdict\n    \n    prefix_sum_count = defaultdict(int)\n    sum = 0\n    count = 0\n    \n    prefix_sum_count[0] = 1\n    \n    for num in arr:\n        sum += num\n        \n        if (sum - k) in prefix_sum_count:\n            count  += prefix_sum_count[sum - k]\n        \n        prefix_sum_count[sum] += 1\n    \n    # by default , defaultdict has value as zero \n    return count",
      "autoResize": true,
      "lineHeight": 1.25
    }
