      "seed": 2110848496,
      "version": 208,
      "versionNonce": 1497931248,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786822185839,
      "link": null,
      "locked": false,
      "text": "Internal Difference: C++ (unordered map)\n* Use separate chaining \n* worst case attacks possible (CF hacks)\n* Slower than map sometimes due to collision\n* can use custom hash to avoid hacking",
      "fontSize": 39,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Internal Difference: C++ (unordered map)\n* Use separate chaining \n* worst case attacks possible (CF hacks)\n* Slower than map sometimes due to collision\n* can use custom hash to avoid hacking",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QKZKFLRw7iqRDPbTgnChN",
      "type": "text",
      "x": 4177.519841269842,
      "y": 114618.95833333331,
      "width": 1201.2005615234375,
      "height": 487.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6C",
      "roundness": null,
      "seed": 1964778480,
      "version": 322,
      "versionNonce": 558122768,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786822295174,
      "link": null,
      "locked": false,
      "text": "Python : Dict \n* Uses open addressing (probing)\n* very optimized in Cpython\n* CPython is the standard implementation of python(it is\nwhat we are using while runnnig python 3)\n* Randomized Hasing -> prevents hacking\n\nPractically: \nvery stablee O(1)\nrarely degrades",
      "fontSize": 39,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Python : Dict \n* Uses open addressing (probing)\n* very optimized in Cpython\n* CPython is the standard implementation of python(it is\nwhat we are using while runnnig python 3)\n* Randomized Hasing -> prevents hacking\n\nPractically: \nvery stablee O(1)\nrarely degrades",
      "autoResize": true,
      "lineHeight": 1.25
    },
