    {
      "id": "PZuybNtzGfpiYEuOrHQiL",
      "type": "text",
      "x": 1338.2036995055187,
      "y": 151993.9583333333,
      "width": 3019.50537109375,
      "height": 3965,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bKl",
      "roundness": null,
      "seed": 1617711918,
      "version": 2289,
      "versionNonce": 839321006,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787260139164,
      "link": null,
      "locked": false,
      "text": "from typing import List\n\nclass Solution:\n    def maxTwoSubarrays(self, nums: List[int]) -> int:\n        # we assume that one subarray will be on left and another will be on right \n        # we follow something similar to kadane algorithm , its like\n        # in array we put a wall and then move that wall, a wall signifies that one choice\n        # of subarray should be taken from left side and another from the right side\n        # for eg lets say wall is after the 2nd index so we have to choose a subarray\n        # from left side (considering only 2 elements exist in the array) so it will\n        # either maximum subarray sum ending at 1st index or maximum subarray sum ending\n        # at the second index which max(p1[0],p1[1])\n        # now to find the maximum in the other part we will calculate s1 array \n        # similar like we calculated in kadane but starting from the end index\n\n        # calculating p1\n        p1 = [None]*(len(nums) + 1)\n        p1[0] = 0\n        for i in range(len(nums)):\n            p1[i+1] = max(p1[i]+nums[i], nums[i])\n\n        # now doing it from backward\n        s1 = [None]*(len(nums)+1)\n        s1[len(nums)] = nums[len(nums)-1]\n        for i in range(len(nums)-2,-1,-1):\n            s1[i+1] = max(s1[i+2] + nums[i], nums[i])\n        \n        # Now in p1 we will update such that ,p1[i] will mean the max subarray sum\n        # till ith index\n        max_till_now = p1[1]\n        for i in range(1,len(p1)):\n            curr_ele = p1[i+1]\n            p1[i+1] = max(max_till_now,curr_ele)\n            max_till_now = p1[i+1]\n\n        # same for s1\n        max_till_now = s1[len(nums)]\n        for i in range(len(s1)-2,-1,-1):\n            curr_ele = s1[i+1]\n            s1[i+1] = max(curr_ele, max_till_now)\n            max_till_now = s1[i+1]\n\n        ans = [None]*(len(nums)+1)\n        final_sum = -10**10\n        for i in range(1,len(nums)):\n            # ans[i] means after ith index is the partition, considering 1  based index\n            ans[i] = p1[i]+s1[i+1] \n            final_sum = max(final_sum,ans[i]) \n       \n        return final_sum\n        \n         ",
      "fontSize": 61,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from typing import List\n\nclass Solution:\n    def maxTwoSubarrays(self, nums: List[int]) -> int:\n        # we assume that one subarray will be on left and another will be on right \n        # we follow something similar to kadane algorithm , its like\n        # in array we put a wall and then move that wall, a wall signifies that one choice\n        # of subarray should be taken from left side and another from the right side\n        # for eg lets say wall is after the 2nd index so we have to choose a subarray\n        # from left side (considering only 2 elements exist in the array) so it will\n        # either maximum subarray sum ending at 1st index or maximum subarray sum ending\n        # at the second index which max(p1[0],p1[1])\n        # now to find the maximum in the other part we will calculate s1 array \n        # similar like we calculated in kadane but starting from the end index\n\n        # calculating p1\n        p1 = [None]*(len(nums) + 1)\n        p1[0] = 0\n        for i in range(len(nums)):\n            p1[i+1] = max(p1[i]+nums[i], nums[i])\n\n        # now doing it from backward\n        s1 = [None]*(len(nums)+1)\n        s1[len(nums)] = nums[len(nums)-1]\n        for i in range(len(nums)-2,-1,-1):\n            s1[i+1] = max(s1[i+2] + nums[i], nums[i])\n        \n        # Now in p1 we will update such that ,p1[i] will mean the max subarray sum\n        # till ith index\n        max_till_now = p1[1]\n        for i in range(1,len(p1)):\n            curr_ele = p1[i+1]\n            p1[i+1] = max(max_till_now,curr_ele)\n            max_till_now = p1[i+1]\n\n        # same for s1\n        max_till_now = s1[len(nums)]\n        for i in range(len(s1)-2,-1,-1):\n            curr_ele = s1[i+1]\n            s1[i+1] = max(curr_ele, max_till_now)\n            max_till_now = s1[i+1]\n\n        ans = [None]*(len(nums)+1)\n        final_sum = -10**10\n        for i in range(1,len(nums)):\n            # ans[i] means after ith index is the partition, considering 1  based index\n            ans[i] = p1[i]+s1[i+1] \n            final_sum = max(final_sum,ans[i]) \n       \n        return final_sum\n        \n         ",
      "autoResize": true,
      "lineHeight": 1.25
    },
