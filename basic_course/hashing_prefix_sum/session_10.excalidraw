      "link": null,
      "locked": false,
      "text": "for i in range(len(b)):\n    sum = 0\n    t = 0\n    for j in range(i, -1, -1):\n        sum += b[i]\n        # store sum of elements j...i\n        # remember b[i] can be negative\n        t = max(t,sum)\n    p[i] = t",
      "fontSize": 61,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for i in range(len(b)):\n    sum = 0\n    t = 0\n    for j in range(i, -1, -1):\n        sum += b[i]\n        # store sum of elements j...i\n        # remember b[i] can be negative\n        t = max(t,sum)\n    p[i] = t",
