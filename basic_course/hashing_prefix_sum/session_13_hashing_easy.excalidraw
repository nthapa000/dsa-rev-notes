      "locked": false,
      "text": "class Solution:\n    def firstUniqChar(self, s: str) -> int:\n        frequency = {}\n        idx = 0\n\n        for i in range(len(s)):\n            # Build frequency\n            if s[i] in frequency:\n                frequency[s[i]] += 1\n            else:\n                frequency[s[i]] = 1\n\n            # Check current possible unique character\n            if frequency[s[idx]] > 1:\n                idx += 1\n\n                # Find next possible unique character\n                while idx < len(s) and frequency[s[idx]] > 1:\n                    idx += 1\n\n            if idx == len(s):\n                return -1\n\n        return idx",
      "fontSize": 61,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution:\n    def firstUniqChar(self, s: str) -> int:\n        frequency = {}\n        idx = 0\n\n        for i in range(len(s)):\n            # Build frequency\n            if s[i] in frequency:\n                frequency[s[i]] += 1\n            else:\n                frequency[s[i]] = 1\n\n            # Check current possible unique character\n            if frequency[s[idx]] > 1:\n                idx += 1\n\n                # Find next possible unique character\n                while idx < len(s) and frequency[s[idx]] > 1:\n                    idx += 1\n\n            if idx == len(s):\n                return -1\n\n        return idx",
      "autoResize": true,
      "lineHeight": 1.25
    },
