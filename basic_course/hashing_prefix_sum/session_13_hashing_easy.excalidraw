      "isDeleted": false,
      "boundElements": [],
      "updated": 1787870321933,
      "link": null,
      "locked": false,
      "text": "def firstUniqChar(self, s: str) -> int:\n    counts = Counter(s)\n    for i, c in enumerate(s):\n        if counts[c] == 1:\n            return i\n    return -1",
      "fontSize": 36.64444444444445,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def firstUniqChar(self, s: str) -> int:\n    counts = Counter(s)\n    for i, c in enumerate(s):\n        if counts[c] == 1:\n            return i\n    return -1",
      "autoResize": false,
      "lineHeight": 1.25
    },
