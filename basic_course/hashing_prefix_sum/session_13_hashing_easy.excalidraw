      "seed": 1090739904,
      "version": 11,
      "versionNonce": 1088752960,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787870396990,
      "link": null,
      "locked": false,
      "text": "from typing import List\n\nclass Solution:\n    def firstUniqChar(self, s: str) -> int:\n        counts = [0] * 26\n        for c in s:\n            counts[ord(c) - ord('a')] += 1\n        for i, c in enumerate(s):\n            if counts[ord(c) - ord('a')] == 1:\n                return i\n        return -1",
      "fontSize": 61,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from typing import List\n\nclass Solution:\n    def firstUniqChar(self, s: str) -> int:\n        counts = [0] * 26\n        for c in s:\n            counts[ord(c) - ord('a')] += 1\n        for i, c in enumerate(s):\n            if counts[ord(c) - ord('a')] == 1:\n                return i\n        return -1",
      "autoResize": true,
      "lineHeight": 1.25
    },
