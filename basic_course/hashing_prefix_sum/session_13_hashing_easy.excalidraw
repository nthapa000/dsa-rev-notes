    {
      "id": "Jq750n6VhyzKslbiObr-T",
      "type": "text",
      "x": 1260.287186380165,
      "y": 146599.9583333333,
      "width": 1936.4206635159787,
      "height": 1823.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0H",
      "roundness": null,
      "seed": 1836336832,
      "version": 128,
      "versionNonce": 2070623552,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787870198631,
      "link": null,
      "locked": false,
      "text": "class Solution:\n    def maxOperations(self, nums: List[int], k: int) -> int:\n        if len(nums) == 1:\n            return 0\n        hash_map = {}\n        hash_map[nums[0]] = 1\n        count = 0\n        for i in range(1,len(nums)):\n            diff = k - nums[i]\n            \n            # find the diff in the hash_map if found decrease the freq\n            if diff in hash_map and hash_map[diff]>0:\n                hash_map[diff] -= 1\n                    \n                if nums[i] in hash_map and hash_map[nums[i]]>0:\n                    hash_map[nums[i]] -= 1\n                count += 1\n                continue\n            \n            if nums[i] not in hash_map:\n                hash_map[nums[i]] = 1\n            else:\n                hash_map[nums[i]] += 1\n\n        return count\n\n            \n            \n            ",
      "fontSize": 50.29655172413795,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution:\n    def maxOperations(self, nums: List[int], k: int) -> int:\n        if len(nums) == 1:\n            return 0\n        hash_map = {}\n        hash_map[nums[0]] = 1\n        count = 0\n        for i in range(1,len(nums)):\n            diff = k - nums[i]\n            \n            # find the diff in the hash_map if found decrease the freq\n            if diff in hash_map and hash_map[diff]>0:\n                hash_map[diff] -= 1\n                    \n                if nums[i] in hash_map and hash_map[nums[i]]>0:\n                    hash_map[nums[i]] -= 1\n                count += 1\n                continue\n            \n            if nums[i] not in hash_map:\n                hash_map[nums[i]] = 1\n            else:\n                hash_map[nums[i]] += 1\n\n        return count\n\n            \n            \n            ",
      "autoResize": true,
      "lineHeight": 1.25
    },
