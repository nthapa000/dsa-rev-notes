      "isDeleted": false,
      "boundElements": null,
      "updated": 1787994578665,
      "link": null,
      "locked": false,
      "text": "class Solution:\n    def commonChars(self, words: List[str]) -> List[str]:\n        # maintain two hash_map \n        # one for overall maintaining a min_freq \n        # <char,freq> for each word from a to z\n        # other hash_map if freq, if to mind the freq of each character of a word\n\n        min_freq = {}\n        for i in range(26):\n            # constraints are small\n            if chr(i+97) not in min_freq:\n                min_freq[chr(i+97)] = 1000\n        \n        for i in range(len(words)):\n            curr_word = words[i]\n            freq = {}\n            for i in range(len(curr_word)):\n                if curr_word[i] not in freq:\n                    freq[curr_word[i]] = 1\n                else:\n                    freq[curr_word[i]] += 1\n            \n            \n            # now we need to update the min_freq with respect to freq hash_map\n            for i in range(26):\n                curr_char_freq = freq[chr(i+97)] if chr(i+97) in freq else 0   \n                # CHANGE 1: absent char means freq 0, not \"skip\"\n                if curr_char_freq < min_freq[chr(i+97)]:\n                    min_freq[chr(i+97)] = curr_char_freq\n                \n        \n        ans = []\n        for key,value in min_freq.items():\n            if value!=1000 and value>0:                \n                # CHANGE 2: guard against 1000 surviving as a \"min\" if never touched, and skip zeros\n                ans.extend([key]*value)                 \n                # CHANGE 3: append 'value' copies, not just one\n        return ans",
      "fontSize": 52.35999999999999,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution:\n    def commonChars(self, words: List[str]) -> List[str]:\n        # maintain two hash_map \n        # one for overall maintaining a min_freq \n        # <char,freq> for each word from a to z\n        # other hash_map if freq, if to mind the freq of each character of a word\n\n        min_freq = {}\n        for i in range(26):\n            # constraints are small\n            if chr(i+97) not in min_freq:\n                min_freq[chr(i+97)] = 1000\n        \n        for i in range(len(words)):\n            curr_word = words[i]\n            freq = {}\n            for i in range(len(curr_word)):\n                if curr_word[i] not in freq:\n                    freq[curr_word[i]] = 1\n                else:\n                    freq[curr_word[i]] += 1\n            \n            \n            # now we need to update the min_freq with respect to freq hash_map\n            for i in range(26):\n                curr_char_freq = freq[chr(i+97)] if chr(i+97) in freq else 0   \n                # CHANGE 1: absent char means freq 0, not \"skip\"\n                if curr_char_freq < min_freq[chr(i+97)]:\n                    min_freq[chr(i+97)] = curr_char_freq\n                \n        \n        ans = []\n        for key,value in min_freq.items():\n            if value!=1000 and value>0:                \n                # CHANGE 2: guard against 1000 surviving as a \"min\" if never touched, and skip zeros\n                ans.extend([key]*value)                 \n                # CHANGE 3: append 'value' copies, not just one\n        return ans",
      "autoResize": true,
      "lineHeight": 1.25
    },
