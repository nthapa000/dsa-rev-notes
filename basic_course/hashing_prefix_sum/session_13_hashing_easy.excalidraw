    {
      "id": "bdJWE0MQZXAZWv7ImZ-kn",
      "type": "text",
      "x": 1220.2036995055187,
      "y": 149981.9583333333,
      "width": 1543.302734375,
      "height": 838.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0d",
