      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Z",
      "roundness": null,
      "seed": 1374299840,
      "version": 198,
      "versionNonce": 991872320,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787870342700,
      "link": null,
      "locked": false,
      "text": "class Solution:\n    def firstUniqChar(self, s: str) -> int:\n        # store index in the value of the hash_map\n        hash_map = {}\n        for i in range(len(s)):\n            if s[i] not in hash_map:\n                hash_map[s[i]] = [i]\n            else:\n                hash_map[s[i]].append(i)\n        \n        for key,value in hash_map.items():\n            if len(value) == 1:\n                return value[0]\n        \n        return -1\n\nBetter Solution / Language agnostic",
      "fontSize": 43.77647058823532,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution:\n    def firstUniqChar(self, s: str) -> int:\n        # store index in the value of the hash_map\n        hash_map = {}\n        for i in range(len(s)):\n            if s[i] not in hash_map:\n                hash_map[s[i]] = [i]\n            else:\n                hash_map[s[i]].append(i)\n        \n        for key,value in hash_map.items():\n            if len(value) == 1:\n                return value[0]\n        \n        return -1\n\nBetter Solution / Language agnostic",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "JDW3u-LXp5Xt4V7w7_2_w",
