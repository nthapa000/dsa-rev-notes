    {
      "id": "SJTp02mW_1DxI679550Hr",
      "type": "text",
      "x": 3243.853174603175,
      "y": 150080.875,
      "width": 351.1195068359375,
      "height": 356.25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
