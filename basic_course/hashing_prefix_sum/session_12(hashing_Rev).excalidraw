      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bG0",
      "roundness": null,
      "seed": 2103762774,
      "version": 71,
      "versionNonce": 1218429276,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787820946198,
      "link": null,
      "locked": false,
      "text": "move();\nturnLeft();\nputBeeper();\npickBeeper();\nturnAround();",
      "fontSize": 57,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "move();\nturnLeft();\nputBeeper();\npickBeeper();\nturnAround();",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IwOp_IJrO8-1yX7SnhE49",
      "type": "text",
      "x": 4066.353174603175,
      "y": 150085.875,
      "width": 1100.04150390625,
      "height": 213.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bG1",
      "roundness": null,
      "seed": 475611658,
      "version": 191,
      "versionNonce": 1664914020,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787820946198,
      "link": null,
      "locked": false,
      "text": "to add a more than one Beeper in a \npoint just use putBeeper(); command more\nthan once and it will display on the Beeper",
      "fontSize": 57,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "to add a more than one Beeper in a \npoint just use putBeeper(); command more\nthan once and it will display on the Beeper",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "QpBOmyNkzLXXTvhSiZTWA",
      "type": "text",
      "x": 3233.853174603175,
      "y": 150500.875,
      "width": 858.9318237304688,
      "height": 641.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bG2",
      "roundness": null,
      "seed": 2128272598,
      "version": 92,
      "versionNonce": 1784100316,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787820946198,
      "link": null,
      "locked": false,
      "text": "You can make your own functions\ne.g: A function to turn right\n\nfunction turnRight() {\n   turnLeft();\n   turnLeft();\n   turnLeft();\n}\n",
      "fontSize": 57,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "You can make your own functions\ne.g: A function to turn right\n\nfunction turnRight() {\n   turnLeft();\n   turnLeft();\n   turnLeft();\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "IBdqHXD3OIAz6C7enPpa9",
      "type": "text",
      "x": 4381.353174603175,
      "y": 150575.875,
      "width": 758.3839721679688,
      "height": 641.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bG3",
      "roundness": null,
      "seed": 1936721494,
      "version": 8,
      "versionNonce": 1917101540,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787820946198,
      "link": null,
      "locked": false,
      "text": "// Put a beeper in each corner.\nfunction main(){\n   repeat(4){\n      move();\n      move();\n      putBeeper();\n      turnLeft();\n   }\n}",
      "fontSize": 57,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Put a beeper in each corner.\nfunction main(){\n   repeat(4){\n      move();\n      move();\n      putBeeper();\n      turnLeft();\n   }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "j-qaILHyyco_LOKzkHCYv",
      "type": "text",
      "x": 5389.686507936508,
      "y": 149880.04166666672,
      "width": 1423.173828125,
      "height": 285,
      "angle": 0,
