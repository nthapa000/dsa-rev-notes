      "updated": 1787820946198,
      "link": null,
      "locked": false,
      "text": "frontIsClear(): function which return true if front is clear\nexample\nfrontIsBlocked()\n",
      "fontSize": 57,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "frontIsClear(): function which return true if front is clear\nexample\nfrontIsBlocked()\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "KFIY2NDihgu_o7o3HyD_v",
      "type": "text",
      "x": 5439.919847123505,
      "y": 150322.5416666667,
      "width": 819.86565983644,
      "height": 430,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bG5",
      "roundness": null,
      "seed": 1126550934,
      "version": 219,
      "versionNonce": 503204196,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787820946198,
      "link": null,
      "locked": false,
      "text": "function putBeeperLine(){\n   while(frontIsClear()) {\n      move();\n      putBeeper();\n   }\n}",
      "fontSize": 57.33333333333333,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function putBeeperLine(){\n   while(frontIsClear()) {\n      move();\n      putBeeper();\n   }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
