      "link": null,
      "locked": false,
      "text": "you are standing at \"j\" you want a[i] + a[j] == target , it means that the \nvalue of a[i] should be \"target - a[j]\"\n\n\n",
      "fontSize": 39,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "you are standing at \"j\" you want a[i] + a[j] == target , it means that the \nvalue of a[i] should be \"target - a[j]\"\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
