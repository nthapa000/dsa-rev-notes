      "updated": 1788040287752,
      "link": null,
      "locked": false,
      "text": "if you insert \"L\" in middle of (0...i) and (i+1....n-1)\nnew_answer = old_answer + count of \"CT\" in the suffix[i+1.....n-1]\n\nHence i will prefer the largest suffix\n\n",
      "fontSize": 74,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if you insert \"L\" in middle of (0...i) and (i+1....n-1)\nnew_answer = old_answer + count of \"CT\" in the suffix[i+1.....n-1]\n\nHence i will prefer the largest suffix\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
