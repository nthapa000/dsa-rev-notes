      "link": null,
      "locked": false,
      "text": "do this for each index = \"i\" and take max of all of them  and compare with answer of all seciton",
      "fontSize": 74,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "do this for each index = \"i\" and take max of all of them  and compare with answer of all seciton",
      "autoResize": true,
