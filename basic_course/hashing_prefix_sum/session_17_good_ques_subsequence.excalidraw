    },
    {
      "id": "EvCUYOSLvdcLW_YjWh8fe",
      "type": "text",
      "x": -1546.5470779873542,
      "y": 201337.74999999994,
      "width": 5333.9581931174425,
      "height": 4383.333333333343,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGX",
      "roundness": null,
      "seed": 294840132,
      "version": 150,
      "versionNonce": 1121172604,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788044565040,
      "link": null,
      "locked": false,
      "text": "class Solution:\n    def numOfSubsequences(self, s: str) -> int:\n        # first ill find for without any modification number of LCT sequence\n        # then check for each case after inserting \"L\" or \"C\" or \"T\" appropriately\n\n        l = 0\n        lc = 0\n        lct = 0\n        pre_l = [0]*len(s)\n        for i in range(len(s)):\n            if s[i] == \"L\":\n                l += 1\n            pre_l[i]= l\n\n            if s[i] == \"C\":\n                \n                lc += l\n\n            if s[i] == \"T\":\n                lct += lc\n        \n        # count of no. of subsequence is inside the lct\n\n        # now we will have three cases\n        # case 1: inserting L --> now if we see carefully we can say that if we insert \"L\" at the beginning then we will have the maximum chances of getting the new LCT sequence\n        # new_lct = lct + no.of ct sequence in the string\n\n        c = 0\n        ct = 0\n        for i in range(len(s)):\n            if s[i] == \"C\":\n                c += 1\n\n            if s[i] == \"T\":\n                ct += c\n        \n        new_lct_1 = lct + ct\n\n        # case 3: inserting T --> now if we see carefullt we can say that inserting the T at the end give us the maximum chances to get new_lvt\n\n        # new_lct = old_lct + lc\n        new_lct_2 = lct + lc \n\n        # case 2: inserting C --> it is little complicated, we need to checkout all the possible insertion points \n        # ....C...\n        # it is product of the count L in the prefix of C and the count of T in the suffix of C\n        # pre_l is calculate above\n\n        suf_t = [0]*len(s)\n        t = 0\n        for i in range(len(s)-1,-1,-1):\n            if s[i]==\"T\":\n                t+=1\n            suf_t[i] = t\n        \n        new_lct_3 = 0\n        count = 0\n        for i in range(0,len(s)-1):\n            # we wont be able to get extra lct if we add c at the beginning or at the end\n            count = lct + pre_l[i]*suf_t[i+1]\n            print(count)\n            new_lct_3 = max(count,new_lct_3)\n        \n        return max(new_lct_1,new_lct_2,new_lct_3)",
      "fontSize": 54.79166666666674,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution:\n    def numOfSubsequences(self, s: str) -> int:\n        # first ill find for without any modification number of LCT sequence\n        # then check for each case after inserting \"L\" or \"C\" or \"T\" appropriately\n\n        l = 0\n        lc = 0\n        lct = 0\n        pre_l = [0]*len(s)\n        for i in range(len(s)):\n            if s[i] == \"L\":\n                l += 1\n            pre_l[i]= l\n\n            if s[i] == \"C\":\n                \n                lc += l\n\n            if s[i] == \"T\":\n                lct += lc\n        \n        # count of no. of subsequence is inside the lct\n\n        # now we will have three cases\n        # case 1: inserting L --> now if we see carefully we can say that if we insert \"L\" at the beginning then we will have the maximum chances of getting the new LCT sequence\n        # new_lct = lct + no.of ct sequence in the string\n\n        c = 0\n        ct = 0\n        for i in range(len(s)):\n            if s[i] == \"C\":\n                c += 1\n\n            if s[i] == \"T\":\n                ct += c\n        \n        new_lct_1 = lct + ct\n\n        # case 3: inserting T --> now if we see carefullt we can say that inserting the T at the end give us the maximum chances to get new_lvt\n\n        # new_lct = old_lct + lc\n        new_lct_2 = lct + lc \n\n        # case 2: inserting C --> it is little complicated, we need to checkout all the possible insertion points \n        # ....C...\n        # it is product of the count L in the prefix of C and the count of T in the suffix of C\n        # pre_l is calculate above\n\n        suf_t = [0]*len(s)\n        t = 0\n        for i in range(len(s)-1,-1,-1):\n            if s[i]==\"T\":\n                t+=1\n            suf_t[i] = t\n        \n        new_lct_3 = 0\n        count = 0\n        for i in range(0,len(s)-1):\n            # we wont be able to get extra lct if we add c at the beginning or at the end\n            count = lct + pre_l[i]*suf_t[i+1]\n            print(count)\n            new_lct_3 = max(count,new_lct_3)\n        \n        return max(new_lct_1,new_lct_2,new_lct_3)",
      "autoResize": true,
      "lineHeight": 1.25
    }
  ],
