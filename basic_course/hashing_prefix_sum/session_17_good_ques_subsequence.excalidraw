    {
      "id": "4bzrXY4XNZ6oPyWtGb2Nz",
      "type": "text",
      "x": -1350.5078963038309,
      "y": 201040.66666666663,
      "width": 3907.1943359375,
      "height": 92.5,
      "angle": 0,
      "strokeColor": "#1971c2",
