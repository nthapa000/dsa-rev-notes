      "link": null,
      "locked": false,
      "text": "from collections import Counter\n\ndef minStepEqualPiles(A):\n    cnt = Counter(A)\n    nums = sorted(cnt.keys(), reverse=True)\n\n    k, ans = 0, 0\n\n    for x in nums[:-1]:\n        k += cnt[x]\n        ans += k\n\n    return ans",
      "fontSize": 61,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from collections import Counter\n\ndef minStepEqualPiles(A):\n    cnt = Counter(A)\n    nums = sorted(cnt.keys(), reverse=True)\n\n    k, ans = 0, 0\n\n    for x in nums[:-1]:\n        k += cnt[x]\n        ans += k\n\n    return ans",
      "autoResize": false,
      "lineHeight": 1.25
    },
