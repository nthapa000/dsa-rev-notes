      "boundElements": null,
      "updated": 1787334709844,
      "link": null,
      "locked": false,
      "text": "from collections import Counter\n\n# frequency map\nk = Counter(b)\n\n# array of pairs: [value, frequency]\ng = []\n\nfor u in sorted(k):\n    g.append([u, k[u]])\n\nsize = len(g)\n\nstep = 0\n\nfor i in range(size - 1, 0, -1):\n    g[i - 1][1] = g[i - 1][1] + g[i][1]\n    step = step + g[i][1]\n    g[i][1] = 0",
      "fontSize": 61,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from collections import Counter\n\n# frequency map\nk = Counter(b)\n\n# array of pairs: [value, frequency]\ng = []\n\nfor u in sorted(k):\n    g.append([u, k[u]])\n\nsize = len(g)\n\nstep = 0\n\nfor i in range(size - 1, 0, -1):\n    g[i - 1][1] = g[i - 1][1] + g[i][1]\n    step = step + g[i][1]\n    g[i][1] = 0",
      "autoResize": false,
      "lineHeight": 1.25
    },
