      "boundElements": null,
      "updated": 1787164746514,
      "link": null,
      "locked": false,
      "text": "def find_subarray_sizes(n, k, arr):\n    mp ={0: 0}\n    mp2 = {0: 0}\n    p_sum = 0\n    max_len = 0\n    min_len = float('inf')\n    \n    for j in range(1, n+1):\n        p_sum += arr[j]\n        x = p_sum - k\n        if x in mp:\n            # found one of the valid subarray\n            i = mp[x] + 1\n            curr_len= j-i+1\n            if curr_len > max_len:\n                max_len = curr_len\n\n        if x in mp2:\n            i = mp[x] + 1\n            if curr_len < min_len:\n                min_len = curr_len\n        \n        # for finding largest \n        if p_sum not in mp:\n            mp[p_sum] = j\n        mp2[p_sum] = j\n    \n    return max_len,min_len\n\n\ndef count_subarray_with_length(n,k,arr,target_length):\n    if target_length == 0:\n        return 0\n\n    count = 0\n    window_sum = sum(arr[:target_length])\n\n    if window_sum == k:\n        count += 1\n\n    for i in range(target_lenth, n):\n        window_sum += arr[i] - arr[i-target_length]\n        if window_sum == k:\n            count += 1\n\n    return count ",
      "fontSize": 50,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def find_subarray_sizes(n, k, arr):\n    mp ={0: 0}\n    mp2 = {0: 0}\n    p_sum = 0\n    max_len = 0\n    min_len = float('inf')\n    \n    for j in range(1, n+1):\n        p_sum += arr[j]\n        x = p_sum - k\n        if x in mp:\n            # found one of the valid subarray\n            i = mp[x] + 1\n            curr_len= j-i+1\n            if curr_len > max_len:\n                max_len = curr_len\n\n        if x in mp2:\n            i = mp[x] + 1\n            if curr_len < min_len:\n                min_len = curr_len\n        \n        # for finding largest \n        if p_sum not in mp:\n            mp[p_sum] = j\n        mp2[p_sum] = j\n    \n    return max_len,min_len\n\n\ndef count_subarray_with_length(n,k,arr,target_length):\n    if target_length == 0:\n        return 0\n\n    count = 0\n    window_sum = sum(arr[:target_length])\n\n    if window_sum == k:\n        count += 1\n\n    for i in range(target_lenth, n):\n        window_sum += arr[i] - arr[i-target_length]\n        if window_sum == k:\n            count += 1\n\n    return count ",
