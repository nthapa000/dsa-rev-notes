    {
      "id": "ri1Qph6BUJwfz8Tw_BH1t",
      "type": "text",
      "x": 1178.9166666666688,
      "y": 765138,
      "width": 1319.99853515625,
      "height": 1187.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1V",
      "roundness": null,
      "seed": 1029058189,
      "version": 459,
      "versionNonce": 1439441261,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787052995855,
      "link": null,
      "locked": false,
      "text": "def count_shortest_subarray_with_sum_k(nums, k):\n    n = len(nums)\n    min_len = float(\"inf\")\n    count = 0\n\n    for i in range(len(nums)):\n        sum = 0\n        for j in range(i,len(nums)):\n            sum += nums[j]\n            n_ele = j - i + 1\n            if sum == k:\n                if n_ele < min_ele:\n                    min_ele = min(min_ele,n_ele)\n                    count = 1\n                elif n_ele==min_len:\n                    count += 1\n                \n   return count         \n            ",
      "fontSize": 50,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def count_shortest_subarray_with_sum_k(nums, k):\n    n = len(nums)\n    min_len = float(\"inf\")\n    count = 0\n\n    for i in range(len(nums)):\n        sum = 0\n        for j in range(i,len(nums)):\n            sum += nums[j]\n            n_ele = j - i + 1\n            if sum == k:\n                if n_ele < min_ele:\n                    min_ele = min(min_ele,n_ele)\n                    count = 1\n                elif n_ele==min_len:\n                    count += 1\n                \n   return count         \n            ",
      "autoResize": true,
      "lineHeight": 1.25
    },
