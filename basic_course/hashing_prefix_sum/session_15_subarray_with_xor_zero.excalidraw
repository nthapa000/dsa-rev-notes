    {
      "id": "Ap6kH9FdqcvvuQS6Iu2ey",
      "type": "text",
      "x": -1012.5248997910835,
      "y": 179063.5833333333,
      "width": 2086.916890572213,
      "height": 2295,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3q",
      "roundness": null,
      "seed": 1169423422,
      "version": 51,
      "versionNonce": 329679294,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788013782616,
      "link": null,
      "locked": false,
      "text": "class Solution:\n    def cntSubarrays(self, arr, k):\n        # code here\n        # P(R) = P(L-1) + S(L-R)\n        # sum --> P(R)\n        # S(L-R) --> k\n        # P(L - 1) --> hash_map --> store freq to find  no. of\n        # subarray ending at L-1 with same sum\n        \n        hash_map = {}\n        sum = 0\n        hash_map[0] = 1\n        count = 0\n        for i in range(len(arr)):\n            sum += arr[i]\n            check = sum - k\n            \n            if check in hash_map:\n                count += hash_map[check]\n                if sum in hash_map:\n                    hash_map[sum] += 1\n                else:\n                    hash_map[sum] = 1\n            else:\n                if sum in hash_map:\n                    hash_map[sum] += 1\n                else:\n                    hash_map[sum] = 1\n        \n        return count",
      "fontSize": 61.199999999999996,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution:\n    def cntSubarrays(self, arr, k):\n        # code here\n        # P(R) = P(L-1) + S(L-R)\n        # sum --> P(R)\n        # S(L-R) --> k\n        # P(L - 1) --> hash_map --> store freq to find  no. of\n        # subarray ending at L-1 with same sum\n        \n        hash_map = {}\n        sum = 0\n        hash_map[0] = 1\n        count = 0\n        for i in range(len(arr)):\n            sum += arr[i]\n            check = sum - k\n            \n            if check in hash_map:\n                count += hash_map[check]\n                if sum in hash_map:\n                    hash_map[sum] += 1\n                else:\n                    hash_map[sum] = 1\n            else:\n                if sum in hash_map:\n                    hash_map[sum] += 1\n                else:\n                    hash_map[sum] = 1\n        \n        return count",
      "autoResize": true,
      "lineHeight": 1.25
    },
