    {
      "id": "pbJNxCPxo_cN-gCmioA7t",
      "type": "text",
      "x": -1261.6424220496692,
      "y": 193267.74999999997,
      "width": 2117.4967337943413,
      "height": 1650,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b8F",
      "roundness": null,
      "seed": 1063724606,
      "version": 40,
      "versionNonce": 1051578622,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788027766046,
      "link": null,
      "locked": false,
      "text": "class Solution:\n    def beautifulSubarrays(self, nums: List[int]) -> int:\n        # problem changes to count the subarrays whose XOR is 0 \n        # xor(0-l)^ xor_sub(l_r)=xor(r)\n        # but xor_sub(l_r) = 0 \n        # xor(0-l) ^ 0 = xor(0-l) \n        \n        # we will store prefix_xor as key and freq as value\n        hash_map = {}\n        hash_map[0] = 1\n        # instead of this we can also use if prefix_xor == 0: count+=1\n\n        prefix_xor = 0\n        count = 0\n        for i in range(len(nums)):\n            prefix_xor ^= nums[i]\n            if prefix_xor in hash_map:\n                count += hash_map[prefix_xor]\n                hash_map[prefix_xor] += 1\n            else:\n                hash_map[prefix_xor] = 1 \n\n        return count\n",
      "fontSize": 54.999999999999986,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution:\n    def beautifulSubarrays(self, nums: List[int]) -> int:\n        # problem changes to count the subarrays whose XOR is 0 \n        # xor(0-l)^ xor_sub(l_r)=xor(r)\n        # but xor_sub(l_r) = 0 \n        # xor(0-l) ^ 0 = xor(0-l) \n        \n        # we will store prefix_xor as key and freq as value\n        hash_map = {}\n        hash_map[0] = 1\n        # instead of this we can also use if prefix_xor == 0: count+=1\n\n        prefix_xor = 0\n        count = 0\n        for i in range(len(nums)):\n            prefix_xor ^= nums[i]\n            if prefix_xor in hash_map:\n                count += hash_map[prefix_xor]\n                hash_map[prefix_xor] += 1\n            else:\n                hash_map[prefix_xor] = 1 \n\n        return count\n",
      "autoResize": true,
      "lineHeight": 1.25
    }
