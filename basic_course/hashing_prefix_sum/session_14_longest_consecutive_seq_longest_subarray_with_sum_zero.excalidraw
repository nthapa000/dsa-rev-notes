      "groupIds": [],
      "frameId": null,
      "index": "bEo",
      "roundness": null,
      "seed": 947974546,
      "version": 74,
      "versionNonce": 853608462,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788011223043,
      "link": null,
      "locked": false,
      "text": "class Solution:\n    def maxLength(self, arr):\n        # code here\n        \n        # prefix_sum \n        # p_s = [2, 12, 16]\n        \n        # p(r) = p(l-1) + s(l-r)\n        # s(l-r) = 0\n        \n        prefix_sum_index = {}\n        sum = 0\n        size = 0\n        max_len = 0\n        for i in range(len(arr)):\n            sum += arr[i]\n            if sum==0:\n                size = i+1\n                max_len = max(size,max_len)\n            else:\n                if sum in prefix_sum_index:\n                    size = i-prefix_sum_index[sum]\n                    max_len = max(size,max_len)\n            \n            if sum not in prefix_sum_index:\n                    # first occcurrence will be stored\n                    prefix_sum_index[sum] = i\n                    \n        \n        return max_len",
      "fontSize": 42.173333333333375,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution:\n    def maxLength(self, arr):\n        # code here\n        \n        # prefix_sum \n        # p_s = [2, 12, 16]\n        \n        # p(r) = p(l-1) + s(l-r)\n        # s(l-r) = 0\n        \n        prefix_sum_index = {}\n        sum = 0\n        size = 0\n        max_len = 0\n        for i in range(len(arr)):\n            sum += arr[i]\n            if sum==0:\n                size = i+1\n                max_len = max(size,max_len)\n            else:\n                if sum in prefix_sum_index:\n                    size = i-prefix_sum_index[sum]\n                    max_len = max(size,max_len)\n            \n            if sum not in prefix_sum_index:\n                    # first occcurrence will be stored\n                    prefix_sum_index[sum] = i\n                    \n        \n        return max_len",
      "autoResize": true,
      "lineHeight": 1.25
    }
