    {
      "id": "tKh54Oi2TGZn0ULB5C2U7",
      "type": "text",
      "x": 1929.3872947562204,
      "y": 174754.0833333333,
      "width": 1252.5502449144044,
      "height": 1581.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
