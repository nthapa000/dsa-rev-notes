      "isDeleted": false,
      "boundElements": null,
      "updated": 1786824857532,
      "link": null,
      "locked": false,
      "text": "class Solution:\n    def containsNearbyDuplicate(self, nums: List[int], k: int) -> bool:\n        # hashing approach \n        # in the hashMap, instead of frequency of the element in the array we will\n        # store the index at which it occured \n\n        hashMap = {}\n        for i in range(len(nums)):\n            if nums[i] not in hashMap:\n                hashMap[nums[i]] = i\n            else:\n                # number exist in the hashMap\n                ind_diff = i - hashMap[nums[i]]\n                if ind_diff <= k:\n                    return True\n                hashMap[nums[i]] = i\n        \n        return False",
      "fontSize": 39,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution:\n    def containsNearbyDuplicate(self, nums: List[int], k: int) -> bool:\n        # hashing approach \n        # in the hashMap, instead of frequency of the element in the array we will\n        # store the index at which it occured \n\n        hashMap = {}\n        for i in range(len(nums)):\n            if nums[i] not in hashMap:\n                hashMap[nums[i]] = i\n            else:\n                # number exist in the hashMap\n                ind_diff = i - hashMap[nums[i]]\n                if ind_diff <= k:\n                    return True\n                hashMap[nums[i]] = i\n        \n        return False",
      "autoResize": true,
      "lineHeight": 1.25
    }
