    {
      "id": "I8WK6umH2l0I2lHBAYljI",
      "type": "text",
      "x": -741.4746270574115,
      "y": 257276.08338333323,
      "width": 1465.19775390625,
      "height": 1757.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bXt",
      "roundness": null,
      "seed": 85578630,
      "version": 359,
      "versionNonce": 376114118,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788082364671,
      "link": null,
      "locked": false,
      "text": "distinct = {}\ni = 0\nfor j in range(len(b)):\n    if b[j] not in distinct:\n        distinct[b[j]] = 1\n    else:\n        distinct[b[j]] += 1\n    \n    distinct_num = len(distinct)\n    while distinct_num > k:\n        distinct[b[j]] -= 1\n        if distinct[b[j]] == 0:\n            del distinct[b[j]]\n        i += 1\n        distinct_num = len(distinct)\n\n    count += (j-i+1)\n            \n        ",
      "fontSize": 74,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "distinct = {}\ni = 0\nfor j in range(len(b)):\n    if b[j] not in distinct:\n        distinct[b[j]] = 1\n    else:\n        distinct[b[j]] += 1\n    \n    distinct_num = len(distinct)\n    while distinct_num > k:\n        distinct[b[j]] -= 1\n        if distinct[b[j]] == 0:\n            del distinct[b[j]]\n        i += 1\n        distinct_num = len(distinct)\n\n    count += (j-i+1)\n            \n        ",
      "autoResize": true,
      "lineHeight": 1.25
