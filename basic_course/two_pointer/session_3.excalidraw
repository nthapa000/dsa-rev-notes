      "isDeleted": true,
      "boundElements": null,
      "updated": 1788089500451,
      "link": null,
      "locked": false,
      "text": "from sortedcontainers import SortedSet\ng = SortedSet()\ncount = {}\n\ni = 0\ndiff = 0\nfor j in range(len(s)):\n    g.add(s[j])\n    if s[j] not in count:\n        count[s[j]] = 1\n    else:\n        count[s[j]] += 1\n    \n    while ord(g[-1]) - ord(g[0]) > k:\n        count[s[i]] -= 1\n        if count[s[i]] == 0:\n            g.remove(s[i])\n        i += 1\n\n    ans = max(j-i+1,ans)",
      "fontSize": 74,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from sortedcontainers import SortedSet\ng = SortedSet()\ncount = {}\n\ni = 0\ndiff = 0\nfor j in range(len(s)):\n    g.add(s[j])\n    if s[j] not in count:\n        count[s[j]] = 1\n    else:\n        count[s[j]] += 1\n    \n    while ord(g[-1]) - ord(g[0]) > k:\n        count[s[i]] -= 1\n        if count[s[i]] == 0:\n            g.remove(s[i])\n        i += 1\n\n    ans = max(j-i+1,ans)",
      "autoResize": true,
      "lineHeight": 1.25
    },
