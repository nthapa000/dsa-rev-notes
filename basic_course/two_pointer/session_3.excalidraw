    {
      "id": "_TlstBHd0kiO8Y05v2eZh",
      "type": "text",
      "x": 351.85870627592226,
      "y": 281729.0000499999,
      "width": 2157.0966796875,
      "height": 2867.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bE2",
      "roundness": null,
      "seed": 1775886168,
      "version": 578,
      "versionNonce": 860433192,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788092706756,
      "link": null,
      "locked": false,
      "text": "start = 1 \nend = n\nreversed = False\nturn = 1\nwhile start < end:\n    selected = 0\n    if turn %2 == 0:\n        #how to know we need to add start or the end \n        if reversed == False:\n            p1 += b[start]\n            selected = b[start]\n            start += 1\n        else:\n            p1 += b[end]\n            selected = b[end]\n            end -= 1\n    else:\n        if reversed == False:\n            p2 += b[start]\n            selected = b[start]\n            start += 1\n        else:\n            p2 += b[end]\n            selected = b[end]\n            end -= 1\n    if selected % 2 == 0:\n        if reveresed == False:\n            reversed = True\n        else:\n            reversed = False\n    ",
      "fontSize": 74,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "start = 1 \nend = n\nreversed = False\nturn = 1\nwhile start < end:\n    selected = 0\n    if turn %2 == 0:\n        #how to know we need to add start or the end \n        if reversed == False:\n            p1 += b[start]\n            selected = b[start]\n            start += 1\n        else:\n            p1 += b[end]\n            selected = b[end]\n            end -= 1\n    else:\n        if reversed == False:\n            p2 += b[start]\n            selected = b[start]\n            start += 1\n        else:\n            p2 += b[end]\n            selected = b[end]\n            end -= 1\n    if selected % 2 == 0:\n        if reveresed == False:\n            reversed = True\n        else:\n            reversed = False\n    ",
      "autoResize": true,
      "lineHeight": 1.25
    },
