    {
      "id": "yXdxY42HD7dTtUXj7LOlL",
      "type": "text",
      "x": -492.2601828337497,
      "y": 289879.0000499999,
      "width": 3367.6130297346717,
      "height": 2478.333333333314,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bDK",
      "roundness": null,
      "seed": 514252420,
      "version": 52,
      "versionNonce": 548766468,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788099364986,
      "link": null,
      "locked": false,
      "text": "class Solution:\n    def searchRange(self, nums: List[int], target: int) -> List[int]:\n        start = 0\n        end = len(nums) - 1\n\n        fo = len(nums)\n        while start <= end:\n            mid = (end - start) // 2 + start\n            if nums[mid] == target:\n                # since we need to find the first occurence -> after getting the target we will move left\n                fo = min(fo,mid)\n                end = mid - 1\n            elif nums[mid] > target:\n                end = mid - 1\n            else:\n                start = mid + 1\n        \n        lo = -1\n        start = 0\n        end = len(nums) - 1\n        while start <= end:\n            mid = (end - start) // 2 + start\n            if nums[mid] == target:\n                lo = max(lo,mid)\n                start = mid + 1\n            elif nums[mid]>target:\n                end = mid - 1\n            else:\n                start = mid + 1\n\n        if fo == len(nums):\n            fo = -1\n        \n        return [fo,lo]",
      "fontSize": 58.313725490195615,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution:\n    def searchRange(self, nums: List[int], target: int) -> List[int]:\n        start = 0\n        end = len(nums) - 1\n\n        fo = len(nums)\n        while start <= end:\n            mid = (end - start) // 2 + start\n            if nums[mid] == target:\n                # since we need to find the first occurence -> after getting the target we will move left\n                fo = min(fo,mid)\n                end = mid - 1\n            elif nums[mid] > target:\n                end = mid - 1\n            else:\n                start = mid + 1\n        \n        lo = -1\n        start = 0\n        end = len(nums) - 1\n        while start <= end:\n            mid = (end - start) // 2 + start\n            if nums[mid] == target:\n                lo = max(lo,mid)\n                start = mid + 1\n            elif nums[mid]>target:\n                end = mid - 1\n            else:\n                start = mid + 1\n\n        if fo == len(nums):\n            fo = -1\n        \n        return [fo,lo]",
      "autoResize": true,
      "lineHeight": 1.25
    },
