    {
      "id": "cXGjKr_Po2Es5ngc6JqkE",
      "type": "text",
      "x": -2960.4403659897034,
      "y": 500904.41671666654,
      "width": 2257.200927734375,
      "height": 5940,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9W",
      "roundness": null,
      "seed": 2070585040,
      "version": 635,
      "versionNonce": 2049060048,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788690016382,
      "link": null,
      "locked": false,
      "text": "from typing import List\n\nvisited = [0] * (100000 + 5)\n\nG = [[] for _ in range(10000+5))\nc = 0\n\ndef dfs(source):\n    global c\n    print(source, end= \"\")\n    \n    c+=1\n    visited[source] = 1\n    \n    # G is an adjaceny list \n    for u in G[source]:\n        if visited[u] == 0:\n            dfs(u) \n    \n\ndef main():\n    global c\n    n = int(input())\n    m = int(input())\n    \n    i = 1\n    while i<= m:\n        x,y = map(int,input().split())\n        G[x].append(y)\n        G[y].append(x)\n        \n        i += 1\n\n    i = 1\n    while i <= n:\n        if visited[i] == 0:\n            dfs(i)\n            print()\n            print(c, end=\" \")\n        c = 0\n        i += 1\n\nif __name__ = \"__main__\":\n   main()",
      "fontSize": 108,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "from typing import List\n\nvisited = [0] * (100000 + 5)\n\nG = [[] for _ in range(10000+5))\nc = 0\n\ndef dfs(source):\n    global c\n    print(source, end= \"\")\n    \n    c+=1\n    visited[source] = 1\n    \n    # G is an adjaceny list \n    for u in G[source]:\n        if visited[u] == 0:\n            dfs(u) \n    \n\ndef main():\n    global c\n    n = int(input())\n    m = int(input())\n    \n    i = 1\n    while i<= m:\n        x,y = map(int,input().split())\n        G[x].append(y)\n        G[y].append(x)\n        \n        i += 1\n\n    i = 1\n    while i <= n:\n        if visited[i] == 0:\n            dfs(i)\n            print()\n            print(c, end=\" \")\n        c = 0\n        i += 1\n\nif __name__ = \"__main__\":\n   main()",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    }
  ],
