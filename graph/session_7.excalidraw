    {
      "id": "mvfoGumhJi9ejzGg6Ecty",
      "type": "text",
      "x": -1967.2374557430317,
      "y": 535064.4167166665,
      "width": 3934.3996288158282,
      "height": 9055,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffffff",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bH4",
      "roundness": null,
      "seed": 1777409521,
      "version": 79,
      "versionNonce": 1137380273,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788704579636,
      "link": null,
      "locked": false,
      "text": "Code:\n\nfrom collections import deque\n\nclass Solution:\n    def solve(self, N, M, edges, Q, queries):\n\n        # --------------------------------------------------\n        # 1. Create adjacency list\n        # --------------------------------------------------\n        adj = [[] for _ in range(N)]\n\n        for u, v in edges:\n            adj[u].append(v)\n            adj[v].append(u)\n\n        # --------------------------------------------------\n        # 2. Find connected components\n        # component[i] = component number of node i\n        # --------------------------------------------------\n        component = [-1] * N\n        visited = [0] * N\n\n        component_number = 0\n\n        def bfs(start):\n            q = deque()\n            q.append(start)\n\n            visited[start] = 1\n            component[start] = component_number\n\n            while q:\n                node = q.popleft()\n\n                for neigh in adj[node]:\n                    if visited[neigh] == 0:\n                        visited[neigh] = 1\n                        component[neigh] = component_number\n                        q.append(neigh)\n\n        for i in range(N):\n            if visited[i] == 0:\n                bfs(i)\n                component_number += 1\n\n        # --------------------------------------------------\n        # 3. mark[i] = 0 -> active\n        # mark[i] = 1 -> destroyed\n        # --------------------------------------------------\n        mark = [0] * N\n\n        # --------------------------------------------------\n        # 4. Process queries\n        # --------------------------------------------------\n        for query_type, i in queries:\n\n            # Type 1 -> find smallest active node\n            if query_type == 1:\n\n                # Node itself is active\n                if mark[i] == 0:\n                    print(i)\n\n                else:\n                    # Node is destroyed\n                    # Find smallest active node\n                    # in the same component\n                    answer = -1\n\n                    for node in range(N):\n                        if component[node] == component[i] and mark[node] == 0:\n                            answer = node\n                            break\n\n                    print(answer)\n\n            # Type 2 -> destroy node\n            elif query_type == 2:\n                mark[i] = 1",
      "fontSize": 90.55000000000003,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Code:\n\nfrom collections import deque\n\nclass Solution:\n    def solve(self, N, M, edges, Q, queries):\n\n        # --------------------------------------------------\n        # 1. Create adjacency list\n        # --------------------------------------------------\n        adj = [[] for _ in range(N)]\n\n        for u, v in edges:\n            adj[u].append(v)\n            adj[v].append(u)\n\n        # --------------------------------------------------\n        # 2. Find connected components\n        # component[i] = component number of node i\n        # --------------------------------------------------\n        component = [-1] * N\n        visited = [0] * N\n\n        component_number = 0\n\n        def bfs(start):\n            q = deque()\n            q.append(start)\n\n            visited[start] = 1\n            component[start] = component_number\n\n            while q:\n                node = q.popleft()\n\n                for neigh in adj[node]:\n                    if visited[neigh] == 0:\n                        visited[neigh] = 1\n                        component[neigh] = component_number\n                        q.append(neigh)\n\n        for i in range(N):\n            if visited[i] == 0:\n                bfs(i)\n                component_number += 1\n\n        # --------------------------------------------------\n        # 3. mark[i] = 0 -> active\n        # mark[i] = 1 -> destroyed\n        # --------------------------------------------------\n        mark = [0] * N\n\n        # --------------------------------------------------\n        # 4. Process queries\n        # --------------------------------------------------\n        for query_type, i in queries:\n\n            # Type 1 -> find smallest active node\n            if query_type == 1:\n\n                # Node itself is active\n                if mark[i] == 0:\n                    print(i)\n\n                else:\n                    # Node is destroyed\n                    # Find smallest active node\n                    # in the same component\n                    answer = -1\n\n                    for node in range(N):\n                        if component[node] == component[i] and mark[node] == 0:\n                            answer = node\n                            break\n\n                    print(answer)\n\n            # Type 2 -> destroy node\n            elif query_type == 2:\n                mark[i] = 1",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
