    {
      "id": "VWiONxpkm17oS4vBU7Lny",
      "type": "text",
      "x": -1824.840390403766,
      "y": 527981.9167166665,
      "width": 4752.001953125,
      "height": 6210,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bFc",
      "roundness": null,
      "seed": 689281375,
      "version": 1012,
      "versionNonce": 635473823,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1788703899135,
      "link": null,
      "locked": false,
      "text": "read -> n\nread -> m\n\nfor i -> m:\n    read -> u,v\n    G[u].append(v)\n    G[v].append(u)\n\nadjacency_list_t = []\n\nvis = [0]*(n+2)\n\nread -> q\nmark = [0]*(n+1)\n\nfor i=1 -> q:\n    read-> type\n    read -> id\n    if type == 2:\n        mark[id] = 1\n    if type == 1:\n        if mark[id] == 0:\n            # id is on\n            print(id)\n        else\n            component_no = p[d]\n            # travel all node of the component by travelling t[component_number]\n            for (auto u: t[component_number]):\n                if mark[u] == 0:\n                        md = min(md,u)\n           \n                if md==1e18\n                    print -1\n                else\n                    print md\n\n\n\ndfs(source):\n    # we might need to dfs again and again in the same component\n    p[source] = d + 1\n    # p[node] is in which component\n    t[d+1].append(source)\n\n\n        ",
      "fontSize": 108,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "read -> n\nread -> m\n\nfor i -> m:\n    read -> u,v\n    G[u].append(v)\n    G[v].append(u)\n\nadjacency_list_t = []\n\nvis = [0]*(n+2)\n\nread -> q\nmark = [0]*(n+1)\n\nfor i=1 -> q:\n    read-> type\n    read -> id\n    if type == 2:\n        mark[id] = 1\n    if type == 1:\n        if mark[id] == 0:\n            # id is on\n            print(id)\n        else\n            component_no = p[d]\n            # travel all node of the component by travelling t[component_number]\n            for (auto u: t[component_number]):\n                if mark[u] == 0:\n                        md = min(md,u)\n           \n                if md==1e18\n                    print -1\n                else\n                    print md\n\n\n\ndfs(source):\n    # we might need to dfs again and again in the same component\n    p[source] = d + 1\n    # p[node] is in which component\n    t[d+1].append(source)\n\n\n        ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
